// Prisma schema para MongoDB
// Provider: mongodb

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String @id @map("_id") @default(auto()) @db.ObjectId
  email     String @unique
  name      String
  password  String
  cpf       String?
  whatsapp  String?
  role      String @default("USER")
  createdAt DateTime @default(now())
  orders    Order[]
  addresses Address[]
  cart      Cart?
  favorites Favorite[]
}

model RefreshToken {
  id        String @id @map("_id") @default(auto()) @db.ObjectId
  token     String
  userId    String @db.ObjectId
  createdAt DateTime @default(now())
}

// --- Product-related models ---

model Brand {
  id        String    @id @map("_id") @default(auto()) @db.ObjectId
  name      String
  logo      String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Category {
  id        String     @id @map("_id") @default(auto()) @db.ObjectId
  name      String
  description String?
  parentId  String?    @db.ObjectId
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryParent")
  products  Product[]
}

model Product {
  id          String    @id @map("_id") @default(auto()) @db.ObjectId
  name        String
  description String?
  price       Float
  stock       Int       @default(0)
  sku         String?   @unique
  images      Image[]
  brandId     String?   @db.ObjectId
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId  String?   @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating      Float     @default(0)
  isOffer     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
}

model Image {
  id        String  @id @map("_id") @default(auto()) @db.ObjectId
  url       String
  alt       String?
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Review {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  rating    Int
  comment   String?
  userId    String?  @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
}

// --- Order-related models ---

model OrderItem {
  id        String  @id @map("_id") @default(auto()) @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int
  unitPrice Float
  total     Float
  lists     OrderItemList[]
}

model Order {
  id             String      @id @map("_id") @default(auto()) @db.ObjectId
  userId         String      @db.ObjectId
  user           User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items          OrderItem[]
  itemsJson      Json?
  externalId     String?
  // Armazenar endereços como JSON para manter a estrutura (street, number, complement, city, state, country, postalCode, isDefault)
  shippingAddress Json?
  billingAddress  Json?
  // Pagamento: apenas PIX via MercadoPago
  paymentMethod   PaymentMethod @default(PIX)
  paymentStatus   PaymentStatus @default(PENDING)
  // Campos do MercadoPago / PIX
  mpPreferenceId  String?   // id da preference criado no MercadoPago
  mpIdempotencyKey String?  // chave de idempotência usada ao criar pagamento no MP
  mpQrCodeBase64  String?   // QR code em base64 (imagem) retornado pela API
  mpQrCodeUrl     String?   // URL público para o QR code (se houver)
  paymentExpiresAt DateTime?
  paidAt          DateTime?
  subtotal        Float
  shippingCost    Float     @default(0)
  tax             Float     @default(0)
  total           Float
  status          String    @default("PENDING")
  // Rastreamento e entrega
  trackingCode    String?   // Código de rastreamento dos Correios
  deliveryMethod  String    @default("PENDING") // PENDING, CORREIOS, LOCAL
  isDelivered     Boolean   @default(false) // Entrega confirmada (local)
  deliveredAt     DateTime? // Data/hora da entrega
  trackingUrl     String?   // URL do rastreamento
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Address {
  id         String   @id @map("_id") @default(auto()) @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  city       String
  state      String
  postalCode String
  country    String
  number     String
  complement String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Cart {
  id        String     @id @map("_id") @default(auto()) @db.ObjectId
  userId    String     @unique @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String  @id @map("_id") @default(auto()) @db.ObjectId
  cartId    String  @db.ObjectId
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  quantity  Int
  unitPrice Float
  total     Float
}

model Favorite {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  productData Json?   // Armazena dados do produto (nome, preço, imagem, slug) para referência rápida
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// --- Content Management Models ---

model Banner {
  id          String    @id @map("_id") @default(auto()) @db.ObjectId
  title       String
  description String?
  imageUrl    String
  buttonText  String?
  linkUrl     String?
  isActive    Boolean   @default(true)
  numberOfDiscountDate Int      @default(0)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CarouselImage {
  id          String    @id @map("_id") @default(auto()) @db.ObjectId
  title       String
  description String?
  imageUrl    String
  linkUrl     String?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Offer {
  id          String    @id @map("_id") @default(auto()) @db.ObjectId
  productId   String    @db.ObjectId
  discount    Float     // Percentual de desconto
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CategoryGrid {
  id          String    @id @map("_id") @default(auto()) @db.ObjectId
  name        String    @unique
  title       String
  description String?
  href        String?
  imgSrc      String?
  imgWidth    Int       @default(190)
  imgHeight   Int       @default(240)
  backgroundColor String?
  flexDirection String?
  paddingBlock String?
  paddingInline String?
  gridColumn  String?
  isCentered  Boolean   @default(false)
  isSmall     Boolean   @default(false)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Configurações simples em formato key-value (ex: whatsapp number, site settings)
model Setting {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Emails registrados no footer
model Email {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  PIX
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// Tamanhos para produtos que precisam de especificação por item
enum Size {
  PP
  P
  M
  G
  GG
  EXG
  EXGG
  BLPP
  BLP
  BLM
  BLG
  BLGG
  BLEXG
  BLEXGG
  ANOS_2
  ANOS_4
  ANOS_6
  ANOS_8
  ANOS_10
  ANOS_12
  ANOS_14
}

// Armazenamento de listas customizadas vinculadas a um OrderItem
model OrderItemList {
  id          String            @id @map("_id") @default(auto()) @db.ObjectId
  orderItemId String            @db.ObjectId
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  rows        OrderItemListRow[]
  createdAt   DateTime          @default(now())
}

model OrderItemListRow {
  id     String   @id @map("_id") @default(auto()) @db.ObjectId
  listId String   @db.ObjectId
  list   OrderItemList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name   String?
  number String?
  size   Size
}
