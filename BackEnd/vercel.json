{
    "version": 2,
    "builds": [
        {
            "src": "main.js",
            "use": "@vercel/node" 
        }   
    ],
    "routes": [
        {
            "src": "(.*)",
            "dest": "main.js" 
        }
    ],
    "env": {
        "JWT_SECRET": "@jwt_secret",
        "JWT_EXPIRATION": "15m",
        "JWT_REFRESH_EXPIRATION": "7d",
        "DATABASE_URL": "@database_url",
        "NODE_ENV": "production"
    }
}