# Configurações do Banco de Dados
DATABASE_URL="postgresql://postgres:your_password@postgres:5432/shopdb?schema=public"

# Configurações do Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL="redis://:your_redis_password@redis:6379"

# Configurações do JWT e Autenticação
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=3600 # 1 hora em segundos
API_KEY_SECRET=your_api_key_secret

# Configurações do Servidor
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Configurações de CORS
CORS_ORIGIN=http://localhost:3001

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW=900000  # 15 minutos em milissegundos
RATE_LIMIT_MAX=100        # máximo de requisições por janela de tempo

# Configurações de Observabilidade
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# PostgreSQL Exporter
POSTGRES_EXPORTER_ENABLED=true
POSTGRES_EXPORTER_PORT=9187

# Redis Exporter
REDIS_EXPORTER_ENABLED=true
REDIS_EXPORTER_PORT=9121

# Node Exporter
NODE_EXPORTER_ENABLED=true
NODE_EXPORTER_PORT=9100

# Grafana
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_password

# Alert Manager
ALERTMANAGER_PORT=9093
ALERTMANAGER_SLACK_WEBHOOK_URL=your_slack_webhook_url
ALERTMANAGER_EMAIL_TO=your-email@example.com
ALERTMANAGER_EMAIL_FROM=alerts@your-domain.com
ALERTMANAGER_SMTP_HOST=smtp.your-provider.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USERNAME=your_smtp_username
ALERTMANAGER_SMTP_PASSWORD=your_smtp_password

# Prisma
PRISMA_STUDIO_PORT=5555

# Logs
LOG_LEVEL=info                  # debug, info, warn, error
LOG_FORMAT=json                 # json, pretty
ENABLE_REQUEST_LOGGING=true     # habilita logs de requisição HTTP
ENABLE_QUERY_LOGGING=true       # habilita logs de queries do banco de dados

# Backup e Recuperação
BACKUP_ENABLED=true
BACKUP_CRON="0 0 * * *"        # executa backup diário à meia-noite
BACKUP_RETENTION_DAYS=7         # mantém backups por 7 dias

# Métricas de Negócio
ENABLE_BUSINESS_METRICS=true    # habilita coleta de métricas de negócio
ORDER_METRICS_ENABLED=true      # métricas específicas de pedidos
USER_METRICS_ENABLED=true       # métricas específicas de usuários
